{
  "private": true,
  "name": "streax-champ",
  "version": "0.0.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "npm run build:client && npm run build:server",
    "build:client": "cd src/client && vite build",
    "build:server": "cd src/server && vite build",
    "check": "npm run type-check && npm run lint:fix && npm run prettier",
    "deploy": "npm run build && devvit upload",
    "dev": "concurrently -k -p \"[{name}]\" -n \"CLIENT,SERVER,DEVVIT\" -c \"blue,green,magenta\" \"npm run dev:client\" \"npm run dev:server\" \"npm run dev:devvit\"",
    "dev:client": "cd src/client && vite build --watch",
    "dev:devvit": "devvit playtest",
    "dev:server": "cd src/server && vite build --watch",
    "dev:vite": "cd src/client && vite --port 7474",
    "serve-client": "node scripts/serve-and-run-server.js",
    "start:local": "npm run build && node scripts/serve-and-run-server.js",
    "postinstall": "npm run build",
    "launch": "npm run build && npm run deploy && devvit publish",
    "lint": "eslint ./src",
    "lint:fix": "eslint --fix ./src",
    "login": "devvit login",
    "prettier": "prettier-package-json --write ./package.json && prettier --write .",
    "check:topics": "ts-node -P tsconfig.scripts.json ./scripts/checkTopics.ts",
    "type-check": "tsc --build",
    "seed:topics": "ts-node -P tsconfig.scripts.json ./scripts/seedTopics.ts",
    "backfill:topics": "ts-node -P tsconfig.scripts.json ./scripts/backfillTopicNames.ts",
    "ai:test": "ts-node -P tsconfig.scripts.json ./scripts/testGemini.ts",
    "scrape:quiz": "ts-node -P tsconfig.scripts.json ./scripts/testTopicScrapeQuiz.ts",
    "browserless:ping": "ts-node -P tsconfig.scripts.json ./scripts/testBrowserlessPing.ts",
    "browserless:simple": "ts-node -P tsconfig.scripts.json ./scripts/testBrowserlessSimpleScrape.ts"
  },
  "dependencies": {
    "@dataconnect/generated": "file:src/dataconnect-generated",
    "@devvit/public-api": "^0.12.0",
    "@devvit/web": "^0.12.0",
    "devvit": "^0.12.9",
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "clsx": "^2.1.1",
    "express": "5.1.0",
    "firebase": "^12.2.1",
    "firebase-admin": "^12.6.0",
    "framer-motion": "^12.23.12",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.542.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "3.3.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.23.0",
    "@tailwindcss/vite": "4.1.6",
    "@types/express": "5.0.1",
    "@types/node": "22.10.2",
    "@types/react": "19.1.4",
    "@types/react-dom": "19.1.5",
    "@vitejs/plugin-react": "4.4.1",
    "concurrently": "9.1.2",
    "dotenv-cli": "8.0.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "15.15.0",
    "prettier": "3.5.3",
    "prettier-package-json": "2.8.0",
    "prettier-plugin-tailwindcss": "0.6.11",
    "tailwindcss": "4.1.6",
    "ts-node": "10.9.2",
    "typescript": "5.8.2",
    "typescript-eslint": "8.29.0",
    "vite": "^6.3.6",
    "vitest": "3.1.1"
  }
}