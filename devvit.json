{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "streax-champ",
  "permissions": {
    "http": {
      "enable": true,
      "domains": [
        "firestore.googleapis.com",
        "oauth2.googleapis.com",
        "generativelanguage.googleapis.com"
      ]
    },
    "redis": true
  },
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "splash.html",
        "inline": true,
        "height": "tall"
      },
      "game": {
        "entry": "game.html",
        "inline": false
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "media": {
    "dir": "dist/client/assets"
  },
  "menu": {
    "items": [
      {
        "label": "Create Daily Quiz Post",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/create-post"
      }
    ]
  },
  "dev": {
    "subreddit": "streax_champ_dev"
  }
}