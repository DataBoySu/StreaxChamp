{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "streax-champ",
  "permissions": {
    "http": {
      "enable": true,
      "domains": [
        "firestore.googleapis.com",
        "oauth2.googleapis.com",
        "generativelanguage.googleapis.com",
        "openrouter.ai",
        "api.openrouter.ai",
        "www.openrouter.ai",
        "api.groq.com"
      ]
    },
    "redis": true
  },
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "index.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "media": {
    "dir": "dist/client/assets"
  },
  "dev": {
    "subreddit": "streax_champ_dev"
  },
  "menu": {
    "items": [
      {
        "label": "Create a new quiz",
        "description": "Start the Streaks",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/on-app-install"
  }
}