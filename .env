# Shared Environment Variables (copy to .env and customize)
# Firestore / Firebase
FIREBASE_PROJECT_ID=streax-bot-local
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./config/firebase-service-account.json

# Gemini (optional; fallback questions used if unset)
GEMINI_API_KEY=AIzaSyB0Vv5UYORi_jxcEQ2-GFsRhtvvAQCQI6c


# Browserless (server-side only; client must NOT call Browserless directly)
BROWSERLESS_TOKEN=2T3cvZdRcOyv2FO75210bd7bdb611d785a6cc98104fa5cfed
# Optional region override (defaults to production-sfo)
BROWSERLESS_REGION=production-sfo
# Alternative: specify full endpoint instead of token+region
# BROWSERLESS_ENDPOINT=https://production-sfo.browserless.io/scrape?token=REPLACE_ME

# Quiz generation scraping toggle (backend authoritative)
QUIZ_SCRAPE_ENABLED=true

# Notes:
# 1. Do NOT commit real tokens/keys.
# 2. For dev local run, export these before starting dev server.
# 3. Browserless call pattern (server code builds):
#    POST https://<region>.browserless.io/scrape?token=${BROWSERLESS_TOKEN}
#    Body: { "url": "https://www.example.com", "elements": [ { "selector": "h1" } ] }
